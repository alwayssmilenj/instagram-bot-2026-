IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Bot Owners
OWNER_USERNAME=jinshi_1
OWNER_USERNAMES=jinshi_1,jinshi
OWNER_USER_IDS=

# Bot Identity
BOT_NAME=ineffa
BOT_PREFIX=.

# Operational Controls
COMMAND_WORKERS=25
COMMAND_QUEUE_MAX=500
MAX_RSS_MB=2048
CHROMIUM_HEADLESS=false
ALLOW_SELF_COMMANDS=true
POLL_SECONDS=60
MAX_REPLIES_PER_HOUR=30
MAX_GLOBAL_REPLIES_PER_HOUR=120
MIN_REPLY_INTERVAL_SECONDS=1.0
HOME_ALERT_VOLUME_PERCENT=120
LOGIN_TIMEOUT_SECONDS=300
PROXY_URL=

# AI Backend Configuration (Ollama Local)
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=ineffa:latest
AI_TIMEOUT_SECONDS=25
AI_MAX_PROMPT_CHARS=1500
AI_MAX_RESPONSE_CHARS=7200
AI_MAX_TOKENS=64
AI_MAX_GENERATION_SECONDS=10

# Cloud AI Providers (Optional Fast Fallbacks)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=15

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
